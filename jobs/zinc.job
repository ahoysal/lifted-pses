#!/bin/bash

set -euo pipefail

# Reproduces Table 3 (ZINC penalized logP, test MAE) from the paper.
# Runs four encodings sequentially — No PSE, LapPE, RWPE, Hodge — each for
# 5 independent trials, using the default Transformer config (Appendix A.2):
#   d_model=128, heads=2, layers=2, dropout=0.2, epochs=300, batch=32, lr=1e-3
#   K=20 eigenvectors/anchors for all encodings.
#
# Monitor progress:
#   tail -f results/${SLURM_JOB_ID}/zinc_<encoding>.out
# Final per-trial and summary stats are printed at the end of each block.

# -----------------------------------------------------------------------------
# Environment setup
# -----------------------------------------------------------------------------

PROJECT_ROOT="${PROJECT_ROOT:-$(git rev-parse --show-toplevel)}"

if [[ -f "${HOME}/.bashrc" ]]; then
    set +u
    source "${HOME}/.bashrc"
    set -u
fi

if [[ -f "${PROJECT_ROOT}/.venv/bin/activate" ]]; then
    set +u
    source "${PROJECT_ROOT}/.venv/bin/activate"
    set -u
    echo "Activated virtualenv at ${PROJECT_ROOT}/.venv"
elif [[ -f "${PROJECT_ROOT}/venv/bin/activate" ]]; then
    set +u
    source "${PROJECT_ROOT}/venv/bin/activate"
    set -u
    echo "Activated virtualenv at ${PROJECT_ROOT}/venv"
else
    echo "Warning: No virtualenv found. Using system Python."
fi

# -----------------------------------------------------------------------------
# Diagnostics
# -----------------------------------------------------------------------------

cd "${PROJECT_ROOT}"

OUTDIR="results/${SLURM_JOB_ID}"
mkdir -p "${OUTDIR}"

echo "Job:     ${SLURM_JOB_ID} (${SLURM_JOB_NAME})"
echo "Node:    ${SLURMD_NODENAME:-unknown}"
echo "Outdir:  ${OUTDIR}"
echo "Python:  $(python3 --version)"
echo "PyTorch: $(python3 -c 'import torch; print(torch.__version__)')"
echo "CUDA:    $(python3 -c 'import torch; print(torch.cuda.is_available())')"
if python3 -c 'import torch; exit(0 if torch.cuda.is_available() else 1)' 2>/dev/null; then
    echo "GPU:     $(python3 -c 'import torch; print(torch.cuda.get_device_name(0))')"
fi
echo "Start:   $(date)"
echo ""

# -----------------------------------------------------------------------------
# Run — {No PSE, LapPE, RWPE, Hodge, HodgeBond} × 5 trials on ZINC subset
# Each encoding logs to its own file under results/${SLURM_JOB_ID}/
# -----------------------------------------------------------------------------

run_encoding() {
    local name="$1"
    shift
    echo "===== ${name} — $(date) ====="
    python3 -u scripts/holygrail.py -d ZINC -m Transformer "$@" \
        2>&1 | tee "${OUTDIR}/zinc_${name}.out"
    echo ""
}

run_encoding "NoPSE"
run_encoding "LapPE"        --LapPE
run_encoding "RWPE"         --RWPE
run_encoding "Hodge"        --HodgePE
run_encoding "HodgeBond"    --HodgePE --bond-dim 4

echo "End: $(date)"
