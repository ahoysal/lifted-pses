#!/bin/bash
#SBATCH --job-name=controlled_ablation
#SBATCH --partition=gpu
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --gres=gpu:1
#SBATCH --mem=32G
#SBATCH --time=24:00:00
#SBATCH --output=results/%j/%x.out
#SBATCH --error=results/%j/%x.err

set -euo pipefail

OUTERRFILES="results/${SLURM_JOB_ID}"
mkdir -p "${OUTERRFILES}"

# Monitor progress:
#   tail -f results/${SLURM_JOB_ID}/controlled_ablation.err   <- tqdm bars + per-trial lines
#   tail -f results/${SLURM_JOB_ID}/controlled_ablation.out   <- startup info
#   cat  results/controlled_synthetic/*/results.csv            <- saved results so far

# -----------------------------------------------------------------------------
# Environment setup
# -----------------------------------------------------------------------------

PROJECT_ROOT="${PROJECT_ROOT:-/home/cstam5916/lifted-pses}"

if [[ -f "${HOME}/.bashrc" ]]; then
    set +u
    source "${HOME}/.bashrc"
    set -u
fi

if [[ -f "${PROJECT_ROOT}/.venv/bin/activate" ]]; then
    set +u
    source "${PROJECT_ROOT}/.venv/bin/activate"
    set -u
    echo "Activated virtualenv at ${PROJECT_ROOT}/.venv"
elif [[ -f "${PROJECT_ROOT}/venv/bin/activate" ]]; then
    set +u
    source "${PROJECT_ROOT}/venv/bin/activate"
    set -u
    echo "Activated virtualenv at ${PROJECT_ROOT}/venv"
else
    echo "Warning: No virtualenv found. Using system Python."
fi

# -----------------------------------------------------------------------------
# Diagnostics
# -----------------------------------------------------------------------------

cd "${PROJECT_ROOT}"

CONFIG="scripts/caleb_experiments/config_controlled_ablation.yaml"
RESUME="${RESUME:-}"

echo "Job:     ${SLURM_JOB_ID} (${SLURM_JOB_NAME})"
echo "Node:    ${SLURMD_NODENAME:-unknown}"
echo "Config:  ${CONFIG}"
echo "Resume:  ${RESUME:-(no)}"
echo "Python:  $(python3 --version)"
echo "PyTorch: $(python3 -c 'import torch; print(torch.__version__)')"
echo "CUDA:    $(python3 -c 'import torch; print(torch.cuda.is_available())')"
if python3 -c 'import torch; exit(0 if torch.cuda.is_available() else 1)' 2>/dev/null; then
    echo "GPU:     $(python3 -c 'import torch; print(torch.cuda.get_device_name(0))')"
fi
echo "Start:   $(date)"
echo ""

# -----------------------------------------------------------------------------
# Run — all tasks × {Hodge, LapPE, None, RWPE} × 5 trials, Transformer only
# Resume by resubmitting with RESUME=1 sbatch controlled_ablation.job
# Results written to results.csv after every trial
# -----------------------------------------------------------------------------

python3 -u scripts/caleb_experiments/controlled_synthetic.py \
    --config "${CONFIG}" \
    --only-encodings Hodge LapPE None RWPE \
    ${RESUME:+--resume}

echo ""
echo "End: $(date)"
