#!/bin/bash
#SBATCH --job-name=parallel
#SBATCH --partition=gpu
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --gres=gpu:1
#SBATCH --mem=16G
#SBATCH --time=16:00:00
#SBATCH --array=0-2
#SBATCH --output=results/%A/%j_%a.out
#SBATCH --error=results/%A/%j_%a.err

set -euo pipefail

mkdir -p results/out results/err

# -----------------------------------------------------------------------------
# Parameter Array Setup
# -----------------------------------------------------------------------------

# Format: "Dataset Model PSE"
CONFIGS=(
    "-d SDS -m Transformer -r SDS_Transformer_Hodge --HodgePE"
    "-d SDS -m Transformer -r SDS_Transformer_Hodge_RWPE --HodgePE --RWPE"
    "-d SDS -m Transformer -r SDS_Transformer_Hodge_LapPE --HodgePE --LapPE"
    "-d SDS -m Transformer -r SDS_Transformer_Hodge_RWPELiftedRF --HodgePE --RWPELifted"
    "-d SDS -m GCN -r SDS_GCN_Hodge --HodgePE"
    "-d SDS -m GCN -r SDS_GCN_Hodge_RWPE --HodgePE --RWPE"
    "-d SDS -m GCN -r SDS_GCN_Hodge_LapPE --HodgePE --LapPE"
    "-d SDS -m GCN -r SDS_GCN_Hodge_RWPELiftedRF --HodgePE --RWPELifted"
    "-d SDS -m Transformer -r SDS_Transformer_RWPE_LapPE --LapPE --RWPE"
    
    # "-d ZINC -m Transformer -r ZINC_Transformer_RWPELiftedRF_LapPE --LapPE --RWPELifted"
    # "-d ZINC -m Transformer -r ZINC_Transformer_Hodge_RWPELifted --HodgePE --RWPELifted"
)

# Extract the specific parameters for this array task ID
CURRENT_CONFIG="${CONFIGS[$SLURM_ARRAY_TASK_ID]}"

# -----------------------------------------------------------------------------
# Environment setup
# -----------------------------------------------------------------------------

PROJECT_ROOT="${PROJECT_ROOT:-/home/aagrim/pse}"

if [[ -f "${HOME}/.bashrc" ]]; then
    set +u
    source "${HOME}/.bashrc"
    set -u
fi

if [[ -f "${PROJECT_ROOT}/.venv/bin/activate" ]]; then
    set +u
    source "${PROJECT_ROOT}/.venv/bin/activate"
    set -u
    echo "Activated virtualenv at ${PROJECT_ROOT}/.venv"
elif [[ -f "${PROJECT_ROOT}/venv/bin/activate" ]]; then
    set +u
    source "${PROJECT_ROOT}/venv/bin/activate"
    set -u
    echo "Activated virtualenv at ${PROJECT_ROOT}/venv"
else
    echo "Warning: No virtualenv found. Using system Python."
fi

# -----------------------------------------------------------------------------
# Run
# -----------------------------------------------------------------------------

cd "${PROJECT_ROOT}"

echo "Running holygrail.py $CURRENT_CONFIG from $(pwd)"
echo "Using GPU: ${CUDA_VISIBLE_DEVICES:-none}"
echo "Python version: $(python3 --version)"
echo "PyTorch version: $(python3 -c 'import torch; print(torch.__version__)')"
echo "CUDA available: $(python3 -c 'import torch; print(torch.cuda.is_available())')"

if python3 -c 'import torch; exit(0 if torch.cuda.is_available() else 1)' 2>/dev/null; then
    echo "CUDA device: $(python3 -c 'import torch; print(torch.cuda.get_device_name(0))')"
fi
echo ""

# Pass the extracted array parameters directly into the script
python3 -u scripts/holygrail.py $CURRENT_CONFIG