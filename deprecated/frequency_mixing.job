#!/bin/bash
#SBATCH --job-name=freq_mixing
#SBATCH --partition=gpu
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --gres=gpu:1
#SBATCH --mem=32G
#SBATCH --time=12:00:00
#SBATCH --output=results/%j/%x.out
#SBATCH --error=results/%j/%x.err

set -euo pipefail

mkdir -p "results/${SLURM_JOB_ID}"

PROJECT_ROOT="${PROJECT_ROOT:-/home/cstam5916/lifted-pses}"

if [[ -f "${HOME}/.bashrc" ]]; then
    set +u; source "${HOME}/.bashrc"; set -u
fi

if [[ -f "${PROJECT_ROOT}/.venv/bin/activate" ]]; then
    set +u; source "${PROJECT_ROOT}/.venv/bin/activate"; set -u
    echo "Activated virtualenv at ${PROJECT_ROOT}/.venv"
fi

cd "${PROJECT_ROOT}"

echo "Job:     ${SLURM_JOB_ID} (${SLURM_JOB_NAME})"
echo "Node:    ${SLURMD_NODENAME:-unknown}"
echo "Python:  $(python3 --version)"
echo "PyTorch: $(python3 -c 'import torch; print(torch.__version__)')"
echo "CUDA:    $(python3 -c 'import torch; print(torch.cuda.is_available())')"
if python3 -c 'import torch; exit(0 if torch.cuda.is_available() else 1)' 2>/dev/null; then
    echo "GPU:     $(python3 -c 'import torch; print(torch.cuda.get_device_name(0))')"
fi
echo "Start:   $(date)"
echo ""

# Full run: 500 graphs, n=20, p=0.35, 150 rewires, 3 trials
# Results go to results/frequency_mixing/n20_p0.35_g500_r150/
python3 -u scripts/caleb_experiments/frequency_mixing.py \
    --n 20 \
    --p 0.35 \
    --num-graphs 500 \
    --rewires 150 \
    --trials 3 \
    --out-dir results/frequency_mixing \
    --seed 42

echo ""
echo "End: $(date)"
