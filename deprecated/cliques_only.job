#!/bin/bash
#SBATCH --job-name=cliques_only
#SBATCH --partition=gpu
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --gres=gpu:1
#SBATCH --mem=32G
#SBATCH --time=30:00:00
#SBATCH --output=results/%j/%x.out
#SBATCH --error=results/%j/%x.err

set -euo pipefail

OUTERRFILES="results/${SLURM_JOB_ID}"
mkdir -p "${OUTERRFILES}"

# Monitor progress:
#   tail -f results/${SLURM_JOB_ID}/cliques_only.err
#   cat  results/controlled_synthetic/nTrain5000_nEval1000_seqLen5_nodes18-22_prob0.3-0.4_nswap2/results.csv
#   cat  results/controlled_synthetic/nTrain5000_nEval1000_seqLen5_nodes18-22_prob0.3-0.4_nswap2/epoch_losses.csv

PROJECT_ROOT="${PROJECT_ROOT:-/home/cstam5916/lifted-pses}"

if [[ -f "${HOME}/.bashrc" ]]; then
    set +u
    source "${HOME}/.bashrc"
    set -u
fi

if [[ -f "${PROJECT_ROOT}/.venv/bin/activate" ]]; then
    set +u
    source "${PROJECT_ROOT}/.venv/bin/activate"
    set -u
    echo "Activated virtualenv at ${PROJECT_ROOT}/.venv"
elif [[ -f "${PROJECT_ROOT}/venv/bin/activate" ]]; then
    set +u
    source "${PROJECT_ROOT}/venv/bin/activate"
    set -u
    echo "Activated virtualenv at ${PROJECT_ROOT}/venv"
else
    echo "Warning: No virtualenv found. Using system Python."
fi

cd "${PROJECT_ROOT}"

CONFIG="scripts/caleb_experiments/config_controlled_v2.yaml"
RESUME="${RESUME:-}"

echo "Job:     ${SLURM_JOB_ID} (${SLURM_JOB_NAME})"
echo "Node:    ${SLURMD_NODENAME:-unknown}"
echo "Config:  ${CONFIG}"
echo "Resume:  ${RESUME:-(no)}"
echo "Python:  $(python3 --version)"
echo "PyTorch: $(python3 -c 'import torch; print(torch.__version__)')"
echo "CUDA:    $(python3 -c 'import torch; print(torch.cuda.is_available())')"
if python3 -c 'import torch; exit(0 if torch.cuda.is_available() else 1)' 2>/dev/null; then
    echo "GPU:     $(python3 -c 'import torch; print(torch.cuda.get_device_name(0))')"
fi
echo "Start:   $(date)"
echo ""

# count_four_cliques only, n=[18,22] p=[0.3,0.4]
# Resume by resubmitting with: RESUME=1 sbatch cliques_only.job

python3 -u scripts/caleb_experiments/controlled_synthetic.py \
    --config "${CONFIG}" \
    --only-tasks count_four_cliques \
    ${RESUME:+--resume}

echo ""
echo "End: $(date)"
