#!/bin/bash
#SBATCH --job-name=cliques_cycles_v2
#SBATCH --partition=gpu
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --gres=gpu:1
#SBATCH --mem=32G
#SBATCH --time=30:00:00
#SBATCH --output=results/%j/%x.out
#SBATCH --error=results/%j/%x.err

set -euo pipefail

OUTERRFILES="results/${SLURM_JOB_ID}"
mkdir -p "${OUTERRFILES}"

# Monitor progress:
#   tail -f results/${SLURM_JOB_ID}/cliques_cycles_v2.err   <- tqdm bars + per-trial lines
#   tail -f results/${SLURM_JOB_ID}/cliques_cycles_v2.out   <- startup info
#   cat  results/controlled_synthetic/*/results.csv          <- trial results so far
#   cat  results/controlled_synthetic/*/epoch_losses.csv     <- epoch-level loss curves

# -----------------------------------------------------------------------------
# Environment setup
# -----------------------------------------------------------------------------

PROJECT_ROOT="${PROJECT_ROOT:-$(git rev-parse --show-toplevel)}"

if [[ -f "${HOME}/.bashrc" ]]; then
    set +u
    source "${HOME}/.bashrc"
    set -u
fi

if [[ -f "${PROJECT_ROOT}/.venv/bin/activate" ]]; then
    set +u
    source "${PROJECT_ROOT}/.venv/bin/activate"
    set -u
    echo "Activated virtualenv at ${PROJECT_ROOT}/.venv"
elif [[ -f "${PROJECT_ROOT}/venv/bin/activate" ]]; then
    set +u
    source "${PROJECT_ROOT}/venv/bin/activate"
    set -u
    echo "Activated virtualenv at ${PROJECT_ROOT}/venv"
else
    echo "Warning: No virtualenv found. Using system Python."
fi

# -----------------------------------------------------------------------------
# Diagnostics
# -----------------------------------------------------------------------------

cd "${PROJECT_ROOT}"

CONFIG="scripts/synth_experiments/config_controlled_v2.yaml"
RESUME="${RESUME:-}"

echo "Job:     ${SLURM_JOB_ID} (${SLURM_JOB_NAME})"
echo "Node:    ${SLURMD_NODENAME:-unknown}"
echo "Config:  ${CONFIG}"
echo "Resume:  ${RESUME:-(no)}"
echo "Python:  $(python3 --version)"
echo "PyTorch: $(python3 -c 'import torch; print(torch.__version__)')"
echo "CUDA:    $(python3 -c 'import torch; print(torch.cuda.is_available())')"
if python3 -c 'import torch; exit(0 if torch.cuda.is_available() else 1)' 2>/dev/null; then
    echo "GPU:     $(python3 -c 'import torch; print(torch.cuda.get_device_name(0))')"
fi
echo "Start:   $(date)"
echo ""

# -----------------------------------------------------------------------------
# Run — 2 tasks × 7 encodings × 5 trials, Transformer only, trial-outer loop
# Encodings: None, RWPE, LapPE, RWPELifted, RWPELiftedRandom, Hodge, HodgeRandom
# Early stopping: patience=20 epochs
# Resume by resubmitting with: RESUME=1 sbatch cliques_cycles_v2.job
# Results appended to results.csv and epoch_losses.csv after every trial/10 epochs
# -----------------------------------------------------------------------------

python3 -u scripts/synth_experiments/controlled_synthetic.py \
    --config "${CONFIG}" \
    ${RESUME:+--resume}

echo ""
echo "End: $(date)"
